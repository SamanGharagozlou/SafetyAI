# Frontend simulation only. Integer seconds, 1–86400; default 600 (10 minutes).
# Vite reads this at startup/build time. Restart dev server after changing .env.local.
VITE_DEMO_SESSION_SECONDS=600

# Development/future integration only; build:demo rejects a nonempty endpoint.
# Opt-in only AFTER the backend teammate confirms the contract and privacy policy.
# Blank = no uploads; UI shows "Transcription not connected".
# Root-relative, same-origin paths only. Proposed path: /api/transcribe
VITE_TRANSCRIBE_ENDPOINT=

# Prepared request API config only. Phase 4 UI ALWAYS uses the in-memory mock.
# These paths do not enable real submissions; backend contract/auth is unverified.
VITE_REQUESTS_ENDPOINT=/api/requests
VITE_REQUEST_STATUS_ENDPOINT=/api/requests/{request_id}

# Static publishing: npm run build:demo. All VITE_* inputs are public.
# Only the four reviewed VITE_* keys above are accepted; never add tokens or robot IPs.
# Cloudflare Pages build environment: NODE_VERSION=24. No secrets required.

# Live duplex voice through Vapi (external speech service). Opt-in, off by default.
# Both must be set and be UUIDs, or the app keeps the existing record/review flow.
# build:demo REJECTS non-empty values: the static demo keeps connect-src 'none'
# and must never send visitor audio to a third party.
# The public key is publishable; the Vapi PRIVATE key must never appear here.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
