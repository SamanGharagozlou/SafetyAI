# Copy to .env (git-ignored) and fill in. scripts/setup_edge.sh / setup_brain.sh write a .env with fresh random keys
# if none exists. Real environment variables override this file (leukerbad_g1/settings.py).

# --- keys: every HTTP call between edge, brain and consoles carries X-Api-Key -------------------------------------
EDGE_API_KEY=change-me-edge        # the edge skill server checks this (console buttons, brain -> /verdict)
BRAIN_API_KEY=change-me-brain      # the brain relay / console check this (edge -> /frame, /ask)

# --- where things are (Tailscale MagicDNS names; see docs/REMOTE-OPS.md) -------------------------------------------
BRAIN_URL=http://spark-7a33:8780   # brain relay on the DGX Spark
EDGE_URL=http://edge:8765          # edge skill server at the venue (the brain posts verdicts back here)
COSMOS_URL=http://127.0.0.1:8000/v1  # vLLM Cosmos-Reason2 (OpenAI-compatible), on the brain
COSMOS_MODEL=nvidia/Cosmos-Reason2-2B
COSMOS_API_KEY=change-me-cosmos # vLLM --api-key (scripts/cosmos/serve_reason2.sh binds all interfaces, key required)
BIND_HOST=127.0.0.1                # comma list allowed: 127.0.0.1,<tailnet IP (tailscale ip -4)>; never 0.0.0.0
EDGE_PORT=8765                     # edge skill server port (make edge)

# --- the robot (D1 Ultra-W) ---------------------------------------------------------------------------------------
G1_CONFIG=config/d1w.yaml
D1W_TRANSPORT=ros2                 # ros2 (default, through the SafetyAI team's d1_cmd_vel_bridge) | sdk | mock
FRAME_SOURCE=team                  # team (their detector's MJPEG + /latest.json) | rtsp | video | stills | none
TEAM_DETECTOR_URL=http://127.0.0.1:8090
ROBOT_RTSP=rtsp://172.24.1.41:8554/test
# D1W_CMD_VEL=/cmd_vel_edge       # only when twist_mux runs (launch/twist_mux.launch.py)

# --- concierge (brain) ---------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-sonnet-5-5

# --- ClawMetry (control plane) -------------------------------------------------------------------------------------
CLAWMETRY_OTLP=http://127.0.0.1:4318
CLAWMETRY_CONTROLLER=1
CLAWMETRY_APPROVALS_URL=http://127.0.0.1:8900   # local ClawMetry dashboard: Approve/Deny queue (pre-tool receiver)
