+const CLAWMETRY = process.env.CLAWMETRY_TEE ?? 'http://127.0.0.1:8901';
+function tee(path, req, payload) {
+  if (!CLAWMETRY) return;
+  // Already came through the tap: it has recorded this itself, with the
+  // authority to have refused it. Teeing would log the same command twice.
+  if (req && req.headers['x-clawmetry-forwarded']) return;
+  try {
+    const body = JSON.stringify(payload);
+    const u = new URL(CLAWMETRY + path);
+    const req = require('http').request({
+      hostname: u.hostname, port: u.port, path: u.pathname, method: 'POST',
+      headers: { 'content-type': 'application/json',
+                 'content-length': Buffer.byteLength(body),
+                 ...(TOKEN ? { authorization: 'Bearer ' + TOKEN } : {}) },
+      timeout: 2000,
+    });
+    req.on('error', () => {});       // the collector being down is not an outage
+    req.on('timeout', () => req.destroy());
+    req.end(body);
+  } catch (e) { /* never let observability break the robot */ }
+}
