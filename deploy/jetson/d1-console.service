[Unit]
# The operator console, served FROM the Jetson so it is reachable from
# anywhere over Tailscale - and so the robot leg is loopback rather than the
# ~1s wifi hop a laptop pays.
Description=D1 operator console (tailnet-only via Tailscale Serve)
After=network-online.target d1-vapi-server.service
Wants=network-online.target

[Service]
Type=simple
User=sepa
Group=sepa

# Loopback only. Tailscale Serve reaches it over localhost, so this is what
# keeps the console off the venue wifi. The console has no login of its own:
# being on the tailnet IS the authentication.
Environment=HOST=127.0.0.1
Environment=PORT=5174

# Loopback to the local edge rather than back out through the public funnel.
Environment=ROBOT_URL=http://127.0.0.1:8090

# The bearer token. Read from a root-only file rather than written here:
# systemd unit files are world-readable, and `systemctl cat` would print it.
EnvironmentFile=/etc/d1-console.env

WorkingDirectory=/home/sepa/robot-console
ExecStart=/usr/bin/node /home/sepa/robot-console/server.mjs

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
