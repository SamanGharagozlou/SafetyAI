<?xml version="1.0" encoding="UTF-8" ?>
<!-- UDPv4-only Fast DDS profile for host ROS processes that read from the perception container; see docs/perception.md. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor><transport_id>udp_only</transport_id><type>UDPv4</type></transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps><useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>udp_only</transport_id></userTransports></rtps>
  </participant>
</profiles>
