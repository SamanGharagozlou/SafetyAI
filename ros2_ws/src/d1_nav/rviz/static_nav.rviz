Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: false
      Cell Size: 1
      Plane Cell Count: 40
      Color: 120; 120; 120
    # the saved lidar map: white = free, black = obstacle, grey = not scanned (RViz "map" colour scheme)
    - Class: rviz_default_plugins/Map
      Name: Lidar map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 1
      Draw Behind: true
    # Nav2 costmaps: blue -> red = rising cost, cyan = robot centre may not enter, magenta = lethal
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.55
      Draw Behind: false
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: false
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.7
      Draw Behind: false
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 25; 255; 0
      Line Style: Lines
      Alpha: 1
    - Class: rviz_default_plugins/Polygon
      Name: Robot footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 0; 255; 255
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Marker Scale: 0.4
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    # "2D Pose Estimate" = Place robot (publishes /initialpose; the lidar localizer / hand-placed localizer pick it up)
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    # "2D Goal Pose" = navigate there (bt_navigator listens on /goal_pose). NOTE: unlike the dashboard it does not check "placed" first.
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 30
      X: 0
      Y: 0
      Angle: 0
      Invert Z Axis: false
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
