Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 90; 90; 90
    - Class: rviz_default_plugins/Map
      Name: Occupancy grid (RTAB-Map /map)
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.8
    - Class: rviz_default_plugins/Map
      Name: Local costmap (Nav2)
      Enabled: true
      Topic:
        Value: /costmap/costmap
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz_default_plugins/Path
      Name: Optimised path
      Enabled: true
      Topic:
        Value: /mapPath
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 25; 255; 0
    - Class: rtabmap_rviz_plugins/MapGraph
      Name: Pose graph
      Enabled: true
      Topic:
        Value: /mapGraph
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.4
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Normalize Range: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 40; 40; 40
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
      X: 0
      Y: 0
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Height: 950
  Width: 1600
