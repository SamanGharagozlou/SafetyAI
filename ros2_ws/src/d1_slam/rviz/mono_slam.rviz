Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 120; 120; 120
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Marker Scale: 0.4
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Normalize Range: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (bridge)
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Keep: 100
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 255; 25; 0
        Shaft Length: 0.15
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.04
    - Class: rviz_default_plugins/Path
      Name: Optimised path (RTAB-Map)
      Enabled: true
      Topic:
        Value: /mapPath
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 25; 255; 0
      Line Style: Lines
    - Class: rtabmap_rviz_plugins/MapGraph
      Name: Pose graph (RTAB-Map)
      Enabled: true
      Topic:
        Value: /mapGraph
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
    Background Color: 40; 40; 40
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.9
      Yaw: 3.0
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
