<?xml version="1.0"?>
<package format="3">
  <name>d1_dashboard</name>
  <version>0.1.0</version>
  <description>Developer web dashboard for the AgiBot D1: process control, mapping, map save/load, click-to-navigate, teleop</description>
  <maintainer email="sahilrajpurkar1998@gmail.com">sahilrajpurkar03</maintainer>
  <license>BSD-3-Clause</license>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>action_msgs</depend>
  <exec_depend>nav2_map_server</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
