<?xml version="1.0"?>
<package format="3">
  <name>d1_lidar</name>
  <version>0.1.0</version>
  <description>Live lidar localization for the D1: MetaCam Lite odometry (via rosbridge relay) -> map->odom in a saved lidar map, with status for the dashboard</description>
  <maintainer email="sahilrajpurkar1998@gmail.com">sahilrajpurkar03</maintainer>
  <license>BSD-3-Clause</license>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-websocket</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
