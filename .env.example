# SafetyAI - every environment variable the stack reads, in one place.
#
#   cp .env.example .env     # .env is gitignored; this file is not
#
# Nothing loads this file automatically. It is the reference, and the answer
# to "where are your credentials?": not in the repository. Each service takes
# its own variables the usual way - `env X=... node ...`, a systemd
# EnvironmentFile, or `clawmetry/server.py --env-file`.
#
# [SECRET] marks a real credential. Those must never be committed, pasted into
# a file in this tree, or passed on a command line on a shared machine (it
# shows up in `ps` and in shell history). `python3 scripts/audit_secrets.py`
# enforces that mechanically; `make audit-secrets` runs it.
#
# The frontend has its own file with its own rules: see frontend/.env.example.
# Anything named VITE_* is compiled into the browser bundle and is therefore
# public by definition - never put a [SECRET] there.

# ---------------------------------------------------------------------------
# Robot control plane
# ---------------------------------------------------------------------------

# [SECRET] Bearer token for the Jetson voice/robot server (`d1-vapi-server`).
# Anything holding this can move a physical robot near guests. It lives on the
# Jetson in ~/vapi-robot/start_server.sh and in /etc/d1-console.env (mode
# 0600), installed by deploy/jetson/install-console.sh. Required by
# tools/robot-console, tools/robot-guard, tools/robot-face and
# frontend/scripts/vapi/concierge.mjs.
D1_ROBOT_TOKEN=

# Where the robot HTTP API is. Defaults to the Jetson's tailnet funnel.
ROBOT_URL=http://127.0.0.1:8090
# Optional side services the operator console links to when they are running.
GUARD_URL=
ESCORT_URL=
AGENT_URL=http://127.0.0.1:8091

# Robot camera. Credentials in an RTSP URL are stripped from logs and
# diagnostics (human_perception.config.redact_url) - but prefer a URL without
# them, because an RTSP URL is passed to a decoder as one string.
ROBOT_RTSP=rtsp://192.168.234.1:8554/test
D1_RTSP=rtsp://192.168.234.1:8554/test

# Vendor SDK location, when it is not at third_party/agibot_D1_Edu-Ultra.
AGIBOT_SDK_DIR=

# ---------------------------------------------------------------------------
# Access keys for anything on a tunnel
# ---------------------------------------------------------------------------
# Not third-party credentials - keys this repo mints. Both guard a page that
# can start a billable call and move the robot, so a tunnel hostname (obscure,
# not secret) is not a substitute. Generate a fresh one per run:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24
#
# [SECRET] Operator console (tools/robot-console). The console REFUSES to
# start bound to a non-loopback address without it.
CONSOLE_KEY=
# [SECRET] Robot face / guest join page (tools/robot-face). Baked into the QR,
# so the guest never types it.
FACE_KEY=
# Public URL the QR should point at, when it is not the LAN address.
PUBLIC_URL=
# Guest turn limits (ms): how long one lease and one session may last.
LEASE_MS=8000
SESSION_MAX_MS=480000

# ---------------------------------------------------------------------------
# Vapi (voice)
# ---------------------------------------------------------------------------
# The PUBLIC key and the assistant ids are public by design: a Vapi public key
# is built to ship inside a browser bundle and an assistant id is an opaque
# handle. Working defaults are compiled in (frontend/src/voice/vapiDefaults.ts,
# tools/robot-console/server.mjs, tools/robot-face/server.mjs) so the demo runs
# with no setup; set these only to point at a different assistant.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# [SECRET] The Vapi PRIVATE key. Account-wide: it can read every call
# transcript and create and delete assistants. It appears nowhere in this
# repository (frontend/scripts/vapi/credentials.json is gitignored).
# OPTIONAL and for tuning only - it unlocks the post-call timeline at
# /api/last-call in the operator console. The console works fine without it,
# and never forwards it to the browser.
VAPI_PRIVATE_KEY=

# Assistant sync targets (frontend/scripts/vapi/concierge.mjs). Not secrets.
SIM_URL=
REAL_ROBOT=
WEATHER_URL=
LLM=
VOICE=

# ---------------------------------------------------------------------------
# ClawMetry control plane
# ---------------------------------------------------------------------------

# [SECRET] Token ClawMetry requires on inbound requests, checked against
# Authorization: Bearer and x-vapi-secret. Set it whenever the tap is reachable
# from anything but loopback.
CLAWMETRY_INBOUND_TOKEN=
# [SECRET] Token ClawMetry presents to the upstream robot server. Normally the
# same value as D1_ROBOT_TOKEN.
CLAWMETRY_UPSTREAM_TOKEN=
# Where the patched d1-vapi-server tees events to.
CLAWMETRY_TEE=http://127.0.0.1:8901

# World model (the safety judge). Two backends; set one.
# [SECRET] Brain relay - preferred, carries its own prompt. Sent as X-Api-Key.
BRAIN_URL=
BRAIN_API_KEY=
# [SECRET] Or Cosmos-Reason2 on an OpenAI-compatible endpoint (vLLM).
# With neither set, the kinematic gate runs alone and every run is recorded as
# unjudged rather than silently passing.
COSMOS_URL=
COSMOS_API_KEY=
COSMOS_MODEL=nvidia/Cosmos-Reason2-2B

# ---------------------------------------------------------------------------
# Test harnesses only (no credentials)
# ---------------------------------------------------------------------------
# BASE / CONSOLE  - point a browser test at an already-running server
# CHROME          - path to a Chrome binary for the headless UI tests
# SHOT / SHOTS    - directory to write screenshots to
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH - system Chromium for the frontend e2e run
